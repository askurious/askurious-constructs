{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/askurious/askurious-constructs/schema/construct.schema.json",
  "title": "Askurious construct",
  "description": "constructs/<key>/construct.yaml: metadata, licence and structure of one scale or standard question. The wording is in wording/<lang>.yaml (open licence) or in an instance's private overlay (only its hash here).",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "key", "version", "status", "kind", "name", "short", "description", "scoring", "notes",
               "authors", "year", "sources", "licence", "tags", "family", "structure", "languages", "versions"],
  "properties": {
    "format": {"const": 1},
    "id": {"type": "string", "pattern": "^ask:[a-z][a-z0-9_]*$"},
    "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 34},
    "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true,
                "description": "earlier ids of the same construct (e.g. local:<host>/o12/<key>)"},
    "version": {"$ref": "#/$defs/version"},
    "status": {"enum": ["review", "verified", "retired"]},
    "retired_since": {"type": "string", "pattern": "^\\d{4}\\.(0[1-9]|1[0-2])\\.\\d+$",
                      "description": "catalogue release in which the construct was withdrawn"},
    "kind": {"enum": ["scale", "standard_question"]},
    "requires": {"type": "string", "pattern": "^\\d{4}\\.(0[1-9]|1[0-2])(\\.\\d+)?$",
                 "description": "lowest Askurious release that can use the construct"},
    "name": {"$ref": "#/$defs/text"},
    "short": {"$ref": "#/$defs/text"},
    "description": {"$ref": "#/$defs/text"},
    "scoring": {"$ref": "#/$defs/text"},
    "notes": {"$ref": "#/$defs/text"},
    "authors": {"type": "array", "items": {"$ref": "#/$defs/author"}},
    "authors_text": {"type": "string", "description": "the authors as shown, where the plain list does not give it"},
    "year": {"type": ["integer", "null"], "minimum": 1800, "maximum": 2100},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "citation"],
        "properties": {
          "role": {"enum": ["original", "documentation", "translation", "validation", "other"]},
          "citation": {"type": "string", "minLength": 1},
          "doi": {"type": "string"},
          "url": {"type": "string", "format": "uri"}
        }
      }
    },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wording", "distributable", "permission_required", "commercial"],
      "properties": {
        "wording": {"type": "string", "description": "key from schema/vocab/licences.yaml"},
        "distributable": {"type": "boolean", "description": "the wording may be in this repository"},
        "permission_required": {"type": "boolean", "description": "each study needs its own documented permission"},
        "commercial": {"type": ["boolean", "null"], "description": "commercial use allowed (null: not stated)"}
      }
    },
    "tags": {
      "type": "object",
      "description": "facet (schema/vocab/facets.yaml) -> tag names",
      "additionalProperties": {
        "oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}, "minItems": 1}]
      }
    },
    "family": {"type": ["string", "null"], "description": "id of a file in families/"},
    "structure": {"$ref": "#/$defs/structure"},
    "languages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "wording"],
        "properties": {
          "status": {"enum": ["validated", "source", "working"],
                     "description": "validated language version, wording as in the source, or working translation"},
          "wording": {"enum": ["repo", "overlay"]},
          "sha256": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "scoring_hint": {"type": "string"},
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version"],
        "properties": {
          "version": {"$ref": "#/$defs/version"},
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "note": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "version": {"type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
                "description": "MAJOR.MINOR: major = structure, minor = wording"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["de", "en"],
      "properties": {"de": {"type": "string"}, "en": {"type": "string"}}
    },
    "author": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["family"],
         "properties": {"family": {"type": "string", "minLength": 1}, "given": {"type": "string"},
                        "orcid": {"type": "string", "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$"}}},
        {"type": "object", "additionalProperties": false, "required": ["name"],
         "properties": {"name": {"type": "string", "minLength": 1}}}
      ]
    },
    "code": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "code", "config"],
      "properties": {
        "type": {"type": "string", "description": "Askurious element type (likert, semantic, single_choice, ...)"},
        "code": {"$ref": "#/$defs/code"},
        "config": {
          "type": "object",
          "description": "config of the Askurious element, as stored in the item",
          "properties": {
            "statements": {"type": "array", "items": {"$ref": "#/$defs/row"}},
            "pairs": {"type": "array", "items": {"$ref": "#/$defs/row"}},
            "options": {"type": "array", "items": {"$ref": "#/$defs/row"}}
          }
        },
        "labels": {
          "type": "object",
          "description": "response labels per language of a licensed scale (open scales have them in the wording file)",
          "additionalProperties": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "row": {
      "type": "object",
      "required": ["id", "code"],
      "properties": {"id": {"type": "string"}, "code": {"$ref": "#/$defs/code"}}
    }
  }
}
